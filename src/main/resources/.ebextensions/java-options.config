option_settings:
  aws:elasticbeanstalk:application:environment:
    SPRING_PROFILES_ACTIVE: prod
    SERVER_PORT: 5000
    APP_API_BASE_URL: https://api.thesoulapp.org/api
    APP_WEBSOCKET_URL: wss://api.thesoulapp.org/ws
    FEATURE_TASKS_ENABLED: false
    FEATURE_BLOG_ENABLED: false
    FEATURE_INSIGHTS_ENABLED: false
    
  aws:elasticbeanstalk:application:environment:
    Xms: 512m
    Xmx: 1024m 